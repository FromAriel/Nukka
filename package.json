{
  "name": "nukka",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "pnpm --filter @nukka/harness run smoke",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm smoke",
    "gen:maps": "pnpm --filter @nukka/harness run gen:maps",
    "sim": "pnpm --filter @nukka/harness exec tsx src/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
