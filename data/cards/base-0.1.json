{
  "id": "base",
  "version": "0.1",
  "cards": [
    {
      "id": "propaganda-broadcast",
      "name": "Propaganda Broadcast",
      "copies": 3,
      "plays": ["root"],
      "tags": ["political"],
      "text": "Every other player's hostility toward the target rises by 1. Your blame falls by 1.",
      "target": {
        "type": "player",
        "owner": "other"
      },
      "effects": [
        {
          "op": "hostility",
          "from": "others-except-self",
          "toward": "$target",
          "amount": 1
        },
        {
          "op": "blame",
          "player": "$self",
          "amount": -1
        }
      ],
      "tension": 2,
      "blame": 0,
      "tensionWhen": "always",
      "blameWhen": "always"
    },
    {
      "id": "trade-embargo",
      "name": "Trade Embargo",
      "copies": 2,
      "plays": ["root"],
      "tags": ["economic"],
      "text": "Target can't trade for 2 rounds and loses 2 supplies at the next upkeep. Any trade agreement between you ends without penalty.",
      "target": {
        "type": "player",
        "owner": "other"
      },
      "effects": [
        {
          "op": "modify",
          "player": "$target",
          "stat": "tradeBlocked",
          "value": 1,
          "rounds": 2
        },
        {
          "op": "damage",
          "player": "$target",
          "resource": "supplies",
          "amount": 2,
          "at": "nextUpkeep"
        },
        {
          "op": "cancel",
          "treaty": "trade",
          "between": ["$self", "$target"],
          "breachPenalty": false
        }
      ],
      "tension": 3,
      "blame": 1,
      "tensionWhen": "always",
      "blameWhen": "always"
    },
    {
      "id": "sanctions",
      "name": "Sanctions",
      "copies": 2,
      "plays": ["root"],
      "tags": ["economic"],
      "text": "Target loses 2 production at each of the next 2 upkeeps.",
      "target": {
        "type": "player",
        "owner": "other",
        "filters": ["blame>=5"]
      },
      "effects": [
        {
          "op": "damage",
          "player": "$target",
          "resource": "production",
          "amount": 2,
          "upkeeps": 2
        }
      ],
      "tension": 2,
      "blame": 0,
      "tensionWhen": "always",
      "blameWhen": "always"
    },
    {
      "id": "global-embargo",
      "name": "Global Embargo",
      "copies": 1,
      "plays": ["global"],
      "tags": ["economic"],
      "text": "Every other player chooses Join or Abstain. For each joiner the pariah loses 1 production and 1 supplies at each of the next 2 upkeeps. Your blame falls by 1.",
      "target": {
        "type": "player",
        "owner": "other",
        "filters": ["pariah"]
      },
      "effects": [
        {
          "op": "choice",
          "chooser": "each-other-player",
          "options": [
            {
              "id": "join",
              "label": "Join",
              "effects": [
                {
                  "op": "damage",
                  "player": "$target",
                  "resource": "production",
                  "amount": 1,
                  "upkeeps": 2
                },
                {
                  "op": "damage",
                  "player": "$target",
                  "resource": "supplies",
                  "amount": 1,
                  "upkeeps": 2
                },
                {
                  "op": "modify",
                  "player": "$chooser",
                  "stat": "tradeBlockedWith",
                  "with": "$target",
                  "rounds": 2
                }
              ]
            },
            {
              "id": "abstain",
              "label": "Abstain",
              "effects": []
            }
          ]
        },
        {
          "op": "blame",
          "player": "$self",
          "amount": -1
        }
      ],
      "tension": 3,
      "blame": 0,
      "tensionWhen": "always",
      "blameWhen": "always"
    },
    {
      "id": "ultimatum",
      "name": "Ultimatum",
      "copies": 2,
      "plays": ["root"],
      "tags": ["political", "military"],
      "text": "Name a non-starting territory of the target adjacent to yours. They yield it, or refuse and you may declare war this round at no extra cost, with +1 formation command against it.",
      "target": {
        "type": "territory",
        "owner": "other",
        "filters": ["non-starting", "adjacent-to-self"]
      },
      "effects": [
        {
          "op": "choice",
          "chooser": "target",
          "options": [
            {
              "id": "yield",
              "label": "Yield",
              "effects": [
                {
                  "op": "transfer",
                  "territory": "$target",
                  "to": "$self"
                },
                {
                  "op": "hostility",
                  "from": "$targetOwner",
                  "toward": "$self",
                  "amount": 3
                }
              ]
            },
            {
              "id": "refuse",
              "label": "Refuse",
              "effects": [
                {
                  "op": "modify",
                  "player": "$self",
                  "stat": "freeWarDeclaration",
                  "against": "$targetOwner",
                  "rounds": 1
                },
                {
                  "op": "modify",
                  "player": "$self",
                  "stat": "assaultCommandBonus",
                  "territory": "$target",
                  "delta": 1,
                  "rounds": 1
                }
              ]
            }
          ]
        }
      ],
      "tension": 15,
      "blame": 3,
      "tensionWhen": "always",
      "blameWhen": "always"
    },
    {
      "id": "doomsday-rhetoric",
      "name": "Doomsday Rhetoric",
      "copies": 1,
      "plays": ["global"],
      "tags": ["political", "nuclear"],
      "text": "Every other player pays you 2 production or 2 supplies, or refuses and their hostility toward you rises by 2. You draw 1 card.",
      "requires": ["self.nuclearAssets>=1"],
      "target": {
        "type": "none"
      },
      "effects": [
        {
          "op": "choice",
          "chooser": "each-other-player",
          "options": [
            {
              "id": "pay-production",
              "label": "Pay 2 production",
              "effects": [
                {
                  "op": "transfer",
                  "resource": "production",
                  "amount": 2,
                  "from": "$chooser",
                  "to": "$self"
                }
              ]
            },
            {
              "id": "pay-supplies",
              "label": "Pay 2 supplies",
              "effects": [
                {
                  "op": "transfer",
                  "resource": "supplies",
                  "amount": 2,
                  "from": "$chooser",
                  "to": "$self"
                }
              ]
            },
            {
              "id": "refuse",
              "label": "Refuse",
              "effects": [
                {
                  "op": "hostility",
                  "from": "$chooser",
                  "toward": "$self",
                  "amount": 2
                }
              ]
            }
          ]
        },
        {
          "op": "draw",
          "player": "$self",
          "count": 1
        }
      ],
      "tension": 20,
      "blame": 3,
      "tensionWhen": "always",
      "blameWhen": "always"
    },
    {
      "id": "destabilize-government",
      "name": "Destabilize Government",
      "copies": 2,
      "plays": ["root"],
      "tags": ["political"],
      "text": "Target loses one development order next round and discards one card at random. You draw 1 card.",
      "target": {
        "type": "player",
        "owner": "other"
      },
      "effects": [
        {
          "op": "modify",
          "player": "$target",
          "stat": "developmentOrders",
          "delta": -1,
          "rounds": 1,
          "from": "nextRound"
        },
        {
          "op": "discard",
          "player": "$target",
          "count": 1,
          "random": true
        },
        {
          "op": "draw",
          "player": "$self",
          "count": 1
        }
      ],
      "tension": 8,
      "blame": 2,
      "tensionWhen": "always",
      "blameWhen": "always"
    },
    {
      "id": "arm-the-insurgents",
      "name": "Arm the Insurgents",
      "copies": 2,
      "plays": ["operation"],
      "tags": ["covert", "military"],
      "text": "Target territory is contested for 2 rounds: out of its owner's supply network, and its garrison loses 1 formation.",
      "cost": {
        "ip": 3
      },
      "difficulty": 3,
      "target": {
        "type": "territory",
        "owner": "other"
      },
      "effects": [
        {
          "op": "disable",
          "territory": "$target",
          "status": "contested",
          "rounds": 2
        },
        {
          "op": "damage",
          "territory": "$target",
          "garrisonFormations": 1
        }
      ],
      "tension": 8,
      "blame": 2,
      "tensionWhen": "on-success",
      "blameWhen": "on-exposure"
    },
    {
      "id": "sabotage-crew",
      "name": "Sabotage Crew",
      "copies": 3,
      "plays": ["operation"],
      "tags": ["covert"],
      "text": "Disable one radar, command, power or depot installation until the end of that round's combat.",
      "cost": {
        "ip": 2
      },
      "difficulty": 2,
      "target": {
        "type": "installation",
        "owner": "other",
        "kinds": ["radar", "command", "powerStation", "depot"]
      },
      "effects": [
        {
          "op": "disable",
          "installation": "$target",
          "until": "endOfCombat"
        }
      ],
      "tension": 0,
      "blame": 0,
      "tensionWhen": "on-success",
      "blameWhen": "on-exposure"
    },
    {
      "id": "reconnaissance",
      "name": "Reconnaissance",
      "copies": 3,
      "plays": ["operation"],
      "tags": ["covert"],
      "text": "Until the next upkeep, privately see the target's nuclear breakdown and submarine and patrol positions. Reveals Covert Program assets.",
      "cost": {
        "ip": 1
      },
      "difficulty": 1,
      "target": {
        "type": "player",
        "owner": "other"
      },
      "effects": [
